art/tmp/

# Review renders: keep only the summary sheets
art/characters/*/review/**
!art/characters/*/review/**/
!art/characters/*/review/**/sheet*.png

# Evidence: keep the docs, the manifest and the latest pass only
artifacts/*
!artifacts/*.md
!artifacts/evidence.json
!artifacts/pass-5/
